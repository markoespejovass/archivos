        </PERSONALIZATION>

        <PERSONALIZATION>
            <TAG_NAME>variable_4</TAG_NAME>
            <VALUE>Gracias por comprar a través de la APP...</VALUE>
        </PERSONALIZATION>

        <PERSONALIZATION>
            <TAG_NAME>variable_5</TAG_NAME>
            <VALUE>Esta es la 5ta variable de su transacción</VALUE>
        </PERSONALIZATION>

        <ATTACHMENT>
            <NAME>Prueba_1.pdf</NAME>
            <MIME_TYPE>text/plain</MIME_TYPE>
            <DATA>JVBERi0xLjMKJcTl8uXrp/Og0MTGCjQgMCBvYmoKPDwgL0xlbmd0aCA1IDAgUiAvRmlsdGVyIC9GbGF0ZURl</DATA>
